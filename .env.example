# .env.local (NÃO COMMIT ESTE ARQUIVO)

# Copie este conteúdo para .env.local no seu Codespaces
# Substitua os valores pela sua chave real

# Groq API (Llama 3.1 - Recomendado)
GROQ_API_KEY=gsk_...

# Google Generative AI (Alternativa)
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Supabase (Banco de Dados)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_anon_...
